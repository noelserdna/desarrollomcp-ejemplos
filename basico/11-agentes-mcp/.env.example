# Solo hacen falta para ejecutar de verdad contra la API de Anthropic (claude.ts / claude.py).
# demo.ts, demo.py y las vías en seco (vias-claude.ts, vias_claude.py) no las usan para nada.
# Clave de la API de Anthropic: créala en tu cuenta de la consola de Anthropic. Nunca la subas al repositorio.
ANTHROPIC_API_KEY=
# Identificador del modelo: elígelo en la documentación de modelos de Anthropic.
ANTHROPIC_MODEL=
# Token del servidor MCP remoto para la vía 3 (conector). Solo se usa si envías esa petición.
NORTIA_MCP_TOKEN=

# Variables de la demo (opcionales)
# APROBAR=si             aprueba las tools con efecto (emitir_abono); cualquier otro valor las deniega
# MAX_TOKENS=40000       presupuesto de tokens del bucle
# TIMEOUT_MS=5000        timeout por llamada a tool en TypeScript
# TIMEOUT_S=5            timeout por llamada a tool en Python
# MCP_BASE=http://127.0.0.1:3211   dónde escuchan los servidores de prueba
# RETARDO_FACTURACION_MS=0         retardo artificial de nortia-facturacion (servidores de prueba)
